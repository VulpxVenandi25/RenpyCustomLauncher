init -2 python:

    # El color del texto no interactivo (un azul grisáceo claro para asegurar legibilidad).
    custom_text = "#cbd5e1"

    # Colores para botones: Azul eléctrico para reposo (idle) y naranja brillante para selección (hover).
    custom_idle = "#38bdf8"
    custom_hover = "#f97316"
    custom_disable = "#475569"

    # Colores para botones de texto invertidos (entradas de listas seleccionadas): Azul intenso y naranja cálido.
    custom_reverse_idle = "#0284c7"
    reverse_hover = "#ea580c"
    custom_reverse_text = "#ffffff"

    # Colores para el thumb de la barra de desplazamiento.
    custom_scrollbar_idle = "#334155"
    custom_scrollbar_hover = "#f97316"

    # Patrón de separación adaptado al tono oscuro
    custom_pattern = "images/pattern.png"

    # Fondo general (se recomienda una imagen de tonos nocturnos o azulados)
    custom_background = "chekoanim" #"theme/theme_background_dark.jpg"

    # Fondo de la lista de proyectos (azul medianoche muy oscuro)
    custom_projects_window = Color("#0f172a72") #Null()

    # Fondo de las cajas de información (azul marino oscuro con transparencia)
    custom_info_window = "#0f172ae8"

    # Colores para los títulos de las cajas de información (enfocados en la paleta naranja/azul)
    custom_error_color = "#ef4444"
    custom_info_color = "#cbd5e1"
    custom_interaction_color = "#fb923c"
    custom_question_color = "#fb923c"

    # El color del texto de entrada (naranja dinámico).
    custom_input_color = "#f97316"

    # Fondo de las ventanas de comandos, preferencias y navegación (un tono azul pizarra oscuro)
    custom_window = Color("#1e293b72") #Null()

